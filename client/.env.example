# Copy to .env and point this at your backend.
#
# Local dev (default): leave unset or use localhost.
#   VITE_API_URL=http://localhost:4000
#
# Phone testing over the same WiFi — use your computer's LAN IP:
#   VITE_API_URL=http://192.168.1.23:4000
#
# Production (deployed): your Render backend URL. A bare hostname also works
# (the client assumes https://), e.g. pronto-server.onrender.com
#   VITE_API_URL=https://pronto-server.onrender.com
VITE_API_URL=http://localhost:4000
