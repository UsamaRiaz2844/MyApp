# Copy this file to .env and fill in your real values

# MongoDB Atlas connection string (see SETUP.md for how to get this)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pronto?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173
